{
	"name": "json2graph",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"wasm": "wasm-pack build crates/engine --target web --release --no-pack --out-name engine && wasm-pack build crates/formatter --target web --release --no-pack --out-name formatter",
		"build": "pnpm run wasm && vite build",
		"preview": "pnpm run build && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:engine": "cargo test --workspace",
		"test": "pnpm run test:engine && pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "wrangler types",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lezer/highlight": "^1.2.5",
		"@lucide/svelte": "^1.55.0",
		"@sveltejs/kit": "^3.0.0",
		"bits-ui": "^2.19.5",
		"cn": "^0.4.0",
		"codemirror": "^6.0.2",
		"d3-selection": "^3.0.0",
		"d3-zoom": "^3.0.0",
		"js-yaml": "^5.4.3",
		"mermaid": "^12.2.0",
		"paneforge": "^1.0.2",
		"svelte": "^5.57.1",
		"tailwind-variants": "^3.3.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/d3-selection": "^3.0.12",
		"@types/d3-zoom": "^3.0.9",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.0.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.0",
		"vitest-browser-svelte": "^3.0.0",
		"wasm-pack": "^0.15.0",
		"wrangler": "^4.149.0"
	},
	"imports": {
		"#engine": "./crates/engine/pkg/engine.js",
		"#formatter": "./crates/formatter/pkg/formatter.js",
		"#formatter/wasm": "./crates/formatter/pkg/formatter_bg.wasm",
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
